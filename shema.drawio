<mxfile host="app.diagrams.net" agent="calendar" version="24.7.17"><diagram id="app-schema" name="Схема приложения"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Календарь — схема приложения" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="600" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Сотрудник (браузер)" style="shape=umlActor;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="36" height="64" as="geometry"/></mxCell><mxCell id="c4" value="Администратор (браузер)" style="shape=umlActor;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="772" y="70" width="36" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Страница входа&lt;/b&gt;&lt;br&gt;/accounts/login/&lt;br&gt;логин и пароль домена yanao.ru" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="260" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Страница календаря  /&lt;/b&gt;&lt;br&gt;calendar.html · calendar.js · calendar.css&lt;br&gt;месяц / неделя / день, форма события, поиск, контакты, напоминания,&lt;br&gt;настройки: доступ, интеграции, отчёт .docx" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="225" width="260" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Админка Django  /admin/&lt;/b&gt;&lt;br&gt;роли сотрудников, каталоги AD / LDAP,&lt;br&gt;почтовый сервер, внешние календари" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="225" width="260" height="110" as="geometry"/></mxCell><mxCell id="c8" value="вход" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="328" y="190"/><mxPoint x="170.0" y="190"/></Array></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="328" y="190"/><mxPoint x="480.0" y="190"/></Array></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Django-приложение  (проект main · Python 3.11 · Django 5.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacing=10;fontStyle=1;fontSize=14;arcSize=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="385" width="920" height="615" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;models_employee — пользователи и права&lt;/b&gt;&lt;br&gt;ad_auth.py — вход через домен, создание и обновление пользователя&lt;br&gt;permissions.py — роли: владелец, менеджер, наблюдатель, администратор&lt;br&gt;Delegation — делегирование прав&lt;br&gt;preferences.py — личные настройки&lt;br&gt;API: /api/delegations/, /api/me/settings/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="260" height="190" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;events — события&lt;/b&gt;&lt;br&gt;Event, Attachment (файлы до 20 МБ)&lt;br&gt;views.py — список, поиск, создание, изменение, перенос, удаление&lt;br&gt;report.py — «Отчет по событиям.docx»&lt;br&gt;API: /api/events/, /api/events/report/, /api/attachments/, /api/reminders/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="430" width="260" height="190" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;integrations — внешние календари, почта&lt;/b&gt;&lt;br&gt;sync.py — двусторонняя синхронизация&lt;br&gt;push.py — отправка при сохранении события&lt;br&gt;providers/: exchange, caldav, google&lt;br&gt;invitations.py, ics.py, mailer.py — приглашения с файлом .ics&lt;br&gt;API: /api/integrations/, /api/events/&amp;lt;id&amp;gt;/invite/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="430" width="260" height="190" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;main — проект&lt;/b&gt;&lt;br&gt;settings.py — настройки (+ .env, local_settings.py)&lt;br&gt;urls.py — админка, вход / выход, адреса приложений" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="260" height="140" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Команды manage.py (вручную / cron)&lt;/b&gt;&lt;br&gt;sync_calendars — синхронизация календарей&lt;br&gt;ad_auth_check, directory_check, exchange_check — проверка подключений" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="695" width="260" height="140" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;directory — адресная книга&lt;/b&gt;&lt;br&gt;ldap_client.py — подключение (ldap3), поиск на сервере каталога&lt;br&gt;search.py — ранжирование контактов&lt;br&gt;DirectorySource — настройки каталогов&lt;br&gt;API: /api/contacts/" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="695" width="260" height="140" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;SQLite — db.sqlite3&lt;/b&gt;&lt;br&gt;пользователи, права, события, вложения, внешние календари, каталоги&lt;br&gt;(пароли интеграций зашифрованы)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="260" height="95" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;media/&lt;/b&gt;&lt;br&gt;файлы вложений событий" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;arcSize=6;fontFamily=Helvetica;fon
" parent="1"><mxGeometry x="1090" y="860" width="290" height="80" as="geometry"/></mxCell><mxCell id="c35" value="события" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.105;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="c14" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="450"/><mxPoint x="980" y="285"/></Array></mxGeometry></mxCell><mxCell id="c36" value="события" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.253;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="c14" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="478"/><mxPoint x="1025" y="390"/></Array></mxGeometry></mxCell><mxCell id="c37" value="события" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.411;exitDx=0;exitDy=0;entryX=0;entryY=0.967;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="c14" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="приглашения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.737;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="вход: LDAP-bind от имени пользователя" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.8
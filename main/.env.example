# Образец файла .env. Скопируйте в .env (рядом с manage.py) и заполните.
# Файл .env не попадает в git. Закомментированная строка — используется значение по умолчанию из settings.py.

# ---------- Django ----------
# Новый ключ: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Внимание: если INTEGRATIONS_ENCRYPTION_KEY пуст, смена ключа сделает нечитаемыми сохранённые пароли интеграций.
# DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Адреса сайта со схемой через запятую — когда сайт открывают по HTTPS через прокси: https://calendar.example.ru
# DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 — приложение за обратным прокси, который передаёт X-Forwarded-Proto и X-Forwarded-Host
# DJANGO_BEHIND_PROXY=0
# Каталог базы и файлов событий. Пусто — рядом с manage.py; в образе Docker — /data
# DJANGO_DATA_DIR=
# 1 — статику отдаёт само приложение (нужен пакет whitenoise); в образе Docker включено
# DJANGO_SERVE_STATIC=0

# ---------- Вход через Active Directory ----------
AD_AUTH_DOMAIN=yanao.ru
# Серверы домена через запятую. Пусто — имя домена. Для yanao.ru — LDAPS почтового сервера (за ним каталог yg.loc)
AD_AUTH_SERVERS=email.yanao.ru
# ssl (LDAPS, 636) | starttls (389) | none
AD_AUTH_SECURITY=ssl
# 0 — 636 для ssl, иначе 389
AD_AUTH_PORT=0
AD_AUTH_VERIFY_CERT=1
# Корневой сертификат центра сертификации домена (.pem)
AD_AUTH_CA_CERT_FILE=
# Пусто — из имени домена (DC=yanao,DC=ru). Для yanao.ru — cn=yg.loc
AD_AUTH_BASE_DN=cn=yg.loc
# Пусто — войти может любой пользователь домена
AD_AUTH_REQUIRE_GROUP=
# Члены группы получают роль «Администратор» (одна группа: полный DN, например CN=…,DC=yg,DC=loc)
AD_AUTH_ADMIN_GROUP=
# Пользователи с ролью «Администратор» (логины через запятую), независимо от группы
AD_AUTH_ADMIN_USERS=

# ---------- Роли ----------
# Менеджеры всех календарей с правом чтения (логины через запятую)
CALENDAR_MANAGERS=

# ---------- Внешние календари ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Fernet.generate_key(). Пусто — выводится из SECRET_KEY
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_EXCHANGE_URL=https://email.yanao.ru/EWS/Exchange.asmx
INTEGRATIONS_UID_DOMAIN=calendar.local

# ---------- Почта ----------
# Пусто — письма выводятся в консоль (или используется сервер из админки)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=calendar@localhost
# 1 — приглашения уходят от адреса пользователя, создавшего событие: только если учётной записи почтового сервера
# разрешено отправлять от адресов сотрудников (иначе письма возвращаются: «Not allowed address»);
# 0 — от общего адреса почтового сервера
INTEGRATIONS_MAIL_FROM_USER=0
